# ============================================================
# API key model
# ============================================================
# OpenAI: TTS_PROVIDER=openai, tầng ngữ nghĩa T-05, NAME_FALLBACK_PROVIDER=openai.
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ============================================================
# Clinic
# ============================================================
# Clinic mock đã deploy (§4.2); nghiệp vụ nằm dưới /v1.
CLINIC_MOCK_BASE_URL=
# Bearer key sk_...; mọi endpoint của mock trừ /health đều cần key.
CLINIC_MOCK_API_KEY=
CLINIC_ID=cl_vinmec

# ============================================================
# Bot auth
# ============================================================
# Bearer key cho /v1/calls và /demo-api, dạng sk_..., nhiều key cách nhau dấu phẩy.
# Để trống = tắt auth. /health, /ready, /audio, /demo luôn mở. Xem docs/reference/http-api.md.
BOT_API_KEYS=
# mock: gọi mock đã deploy ở trên. sim: clinic_mock_sim trong bộ nhớ, không cần mạng/key — chỉ demo
# local, dữ liệu mất khi restart; Docker tự chạy 1 worker khi sim. Để trống: uvicorn dùng mock,
# docker compose local dùng sim. Deploy (docker-compose.prod.yml) luôn là mock.
# CLINIC_BACKEND=sim
# Chỉ khi sim — bộ dữ liệu: listing3 (apt_00417 09:00, 2 slot) | mentor_mock (giống mock sau reset)
# CLINIC_SIM_DATASET=listing3
# Chỉ khi sim — edge case dựng sẵn, cách nhau dấu phẩy (xem src/clinic_mock_sim/README.md), vd slot_race
# CLINIC_SIM_SCENARIO=

# ============================================================
# Voice pipeline
# ============================================================

SAMPLE_RATE=8000
ASR_PROVIDER=zipformer
# openai | elevenlabs (ElevenLabs Flash v2.5 qua WebSocket stream-input, xem mục "TTS — ElevenLabs")
TTS_PROVIDER=openai
PUBLIC_BASE_URL=http://localhost:8000
AUDIO_DIR=temp/audio
VAD_RMS_THRESHOLD=500.0
VAD_END_SILENCE_MS=600

# ------------------------------------------------------------
# ASR — Gemini (dùng GEMINI_API_KEY)
# ------------------------------------------------------------
GEMINI_ASR_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# ASR — PhoWhisper
# ------------------------------------------------------------
PHOWHISPER_MODEL=vinai/PhoWhisper-large

# ------------------------------------------------------------
# ASR — ZipFormer
# ------------------------------------------------------------
# Bỏ trống để local dùng asset tại src/inference/asr/providers/assets/zipformer/.
# Xem docs/reference/zipformer-model-setup.md. Docker Compose tự override các đường dẫn này.
ZIPFORMER_ENCODER_PATH=
ZIPFORMER_DECODER_PATH=
ZIPFORMER_JOINER_PATH=
ZIPFORMER_TOKENS_PATH=

# ------------------------------------------------------------
# TTS — OpenAI (dùng OPENAI_API_KEY)
# ------------------------------------------------------------
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ------------------------------------------------------------
# TTS — ElevenLabs (dùng ELEVENLABS_API_KEY)
# ------------------------------------------------------------
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_S=4.0
# pcm_8000 khớp băng hẹp, không phải resample; tuần 5 điện thoại có thể dùng ulaw_8000
ELEVENLABS_OUTPUT_FORMAT=pcm_8000
# Ép model đọc tiếng Việt kể cả câu ngắn dễ đoán nhầm ngôn ngữ; rỗng = để model tự đoán
ELEVENLABS_LANGUAGE_CODE=vi

# ============================================================
# Extraction qua LLM
# ============================================================
SEMANTIC_FALLBACK_ENABLED=true
SEMANTIC_FALLBACK_MODEL=gpt-4o-mini
# Timeout httpx theo pha (không phải trần tổng); một request, không retry
SEMANTIC_FALLBACK_TIMEOUT_S=3.0
SEMANTIC_FALLBACK_MAX_TOKENS=400

# ------------------------------------------------------------
# Name NER fallback: none | openai | gemini | groq | openrouter
# ------------------------------------------------------------
NAME_FALLBACK_PROVIDER=none
NAME_FALLBACK_MODEL=
NAME_FALLBACK_MAX_TOKENS=
NAME_FALLBACK_TIMEOUT_S=3.0

# ============================================================
# Dialogue limits
# ============================================================
MAX_FAILED_UNDERSTANDINGS=2
MAX_SILENT_TURNS=3

# ============================================================
# Redis session
# ============================================================
# Session tạm; Clinic là nơi lưu hồ sơ chính thức.
REDIS_PASSWORD=callbot
REDIS_URL=redis://:callbot@localhost:6379/0
REDIS_KEY_PREFIX=callbot
REDIS_MAXMEMORY=256mb
# Xóa nội dung sau 30 phút không hoạt động / tối đa 2 giờ.
SESSION_IDLE_TTL_S=1800
SESSION_MAX_AGE_S=7200
SESSION_TOMBSTONE_TTL_S=86400
SESSION_MAX_BYTES=262144
SESSION_LOCK_LEASE_S=60

# ============================================================
# HTTP runtime
# ============================================================
# Số process uvicorn của bot. Prod: CD ghi 2 vào .env trên server. Local: docker compose mặc định 1;
# khi CLINIC_BACKEND=sim image tự ép 1. Chạy uvicorn trực tiếp với sim thì đừng dùng --workers > 1.
# WEB_CONCURRENCY=1

# ============================================================
# Phone transport (chưa dùng bởi HTTP voice demo)
# ============================================================
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_auth_token

# ============================================================
# Tracing (opt-in, tắt mặc định)
# ============================================================
# Bật ghi trace span: false (mặc định) | true.
# Khi true, BẮT BUỘC phải set TRACE_PSEUDONYMIZATION_KEY.
TRACE_ENABLED=false
# HMAC-SHA256 key để pseudonymize call_id → call_key (min 32 bytes, hex hoặc base64).
# Tạo: python -c "import secrets; print(secrets.token_hex(32))"
# BẮT BUỘC khi TRACE_ENABLED=true. Nếu rỗng hoặc quá ngắn, tracer sẽ log warning TRACE_CONFIG_INVALID và tự tắt.
TRACE_PSEUDONYMIZATION_KEY=
# Thư mục lưu trace JSONL local; tùy chọn nếu chỉ dùng Langfuse.
# Khi set: tạo thư mục trước khi start app.
TRACE_JSONL_DIR=
# Version của key (mặc định v1). Chỉ thay đổi khi rotate key để phân biệt call_key cũ/mới.
# TRACE_KEY_VERSION=v1
# Môi trường trace, xuất hiện trên Langfuse UI: development | staging | production.
# TRACE_ENVIRONMENT=development

# ============================================================
# Langfuse export (opt-in, tắt mặc định — cần TRACE_ENABLED=true)
# ============================================================
# Bật export sang Langfuse qua OTLP/HTTP: false (mặc định) | true.
# Cần cài đặt TRACE_ENABLED=true. App sử dụng OTLP/HTTP trực tiếp (gửi x-langfuse-ingestion-version: 4), không cần Langfuse Python SDK.
LANGFUSE_EXPORT_ENABLED=false
# OTLP endpoint của Langfuse (env KHÔNG cần thêm /v1/traces, code sẽ tự động normalize).
# Cloud:       https://cloud.langfuse.com/api/public/otel
# Japan:       https://jp.cloud.langfuse.com/api/public/otel
# Self-hosted: https://your-langfuse-host.com/api/public/otel
# BẮT BUỘC khi LANGFUSE_EXPORT_ENABLED=true.
LANGFUSE_OTLP_ENDPOINT=
# Langfuse project credentials (lấy từ Langfuse → Settings → API Keys).
# BẮT BUỘC khi LANGFUSE_EXPORT_ENABLED=true.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Môi trường hiển thị trên Langfuse UI: development | staging | production.
# Phải khớp pattern [a-z0-9_-]{1,40}, không được bắt đầu bằng "langfuse".
# LANGFUSE_ENVIRONMENT=development
# Timeout HTTP gửi đến Langfuse (giây). Tăng lên nếu mạng chậm.
# LANGFUSE_TIMEOUT_SECONDS=2.0
# Kích thước queue nội bộ (spans chờ export). Khi đầy, span mới bị drop (fail-open).
# LANGFUSE_QUEUE_SIZE=1024
# Số span gộp thành một HTTP request.
# LANGFUSE_BATCH_SIZE=32
# Tần suất flush queue định kỳ (giây); không ảnh hưởng flush thủ công khi shutdown.
# LANGFUSE_FLUSH_INTERVAL_SECONDS=1.0

# ============================================================
# Voice Dashboard (Observability API, opt-in)
# ============================================================
# Bật read-only API tại /internal/observability/* và UI tại /observability/: false | true.
# Không cần Langfuse — đọc trực tiếp từ JSONL local.
OBSERVABILITY_API_ENABLED=false
# Thư mục chứa trace JSONL mà dashboard API đọc.
# Thường trùng với TRACE_JSONL_DIR. BẮT BUỘC khi OBSERVABILITY_API_ENABLED=true.
# Nếu rỗng, code fallback sang TRACE_JSONL_DIR; nếu cả hai rỗng → API endpoint trả 404.
OBSERVABILITY_TRACE_DIR=
