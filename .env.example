# ============================================================
# API key model
# ============================================================
# OpenAI: TTS_PROVIDER=openai, tầng ngữ nghĩa T-05, NAME_FALLBACK_PROVIDER=openai.
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ============================================================
# Clinic
# ============================================================
# Clinic mock đã deploy (§4.2); nghiệp vụ nằm dưới /v1.
CLINIC_MOCK_BASE_URL=
# Bearer key sk_...; mọi endpoint của mock trừ /health đều cần key.
CLINIC_MOCK_API_KEY=
CLINIC_ID=cl_vinmec

# ============================================================
# Bot auth
# ============================================================
# Bearer key cho /v1/calls và /demo-api, dạng sk_..., nhiều key cách nhau dấu phẩy.
# Để trống = tắt auth. /health, /ready, /audio, /demo luôn mở. Xem docs/reference/http-api.md.
BOT_API_KEYS=
# mock: gọi mock đã deploy ở trên. sim: clinic_mock_sim trong bộ nhớ, không cần mạng/key — chỉ demo
# local, dữ liệu mất khi restart; Docker tự chạy 1 worker khi sim. Để trống: uvicorn dùng mock,
# docker compose local dùng sim. Deploy (docker-compose.prod.yml) luôn là mock.
# CLINIC_BACKEND=sim
# Chỉ khi sim — bộ dữ liệu: listing3 (apt_00417 09:00, 2 slot) | mentor_mock (giống mock sau reset)
# CLINIC_SIM_DATASET=listing3
# Chỉ khi sim — edge case dựng sẵn, cách nhau dấu phẩy (xem src/clinic_mock_sim/README.md), vd slot_race
# CLINIC_SIM_SCENARIO=

# ============================================================
# Voice pipeline
# ============================================================

SAMPLE_RATE=8000
ASR_PROVIDER=zipformer
# openai | elevenlabs (ElevenLabs Flash v2.5 qua WebSocket stream-input, xem mục "TTS — ElevenLabs")
TTS_PROVIDER=openai
PUBLIC_BASE_URL=http://localhost:8000
AUDIO_DIR=temp/audio
# energy | webrtc | silero — energy dễ hiểu nhầm noise thành turn (baseline). webrtc
# (Google WebRTC's VAD, cần extra [vad-webrtc]) phân biệt tốt hơn energy nhưng vẫn hay bị
# lừa bởi noise phòng không đồng đều (hallucination "ĐÂY"/"Ừ" lặp lại nhiều phút liền dù
# không ai nói). silero (ONNX qua sherpa-onnx, cần model tải bên dưới) đối chiếu thực
# nghiệm qua ASR trên audio LiveKit thật không bỏ sót giọng nói thật ở bất kỳ file nào đã
# kiểm, và từ chối đúng các đoạn thuần noise mà webrtc bị lừa — xem
# docs/reference/livekit-architecture.md §5.4. Cần benchmark thêm trên tập audio đa dạng
# hơn trước khi coi là mặc định cho mọi call; script so sánh: eval/vad-bench/compare_silero_webrtc.py.
VAD_PROVIDER=energy
VAD_RMS_THRESHOLD=500.0
VAD_WEBRTC_AGGRESSIVENESS=2
# Bắt buộc khi VAD_PROVIDER=silero — cũng dùng cho NoiseTracker (Speech Admission/Turn
# Validator, luôn Silero bất kể VAD_PROVIDER).
# Tải: curl -L -o src/speech/asr/vad/assets/silero_vad.onnx \
#   https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx
SILERO_VAD_MODEL_PATH=src/speech/asr/vad/assets/silero_vad.onnx
VAD_END_SILENCE_MS=600
# Turn Controller (đường LiveKit streaming): turn ngắn hơn ngưỡng này bị coi là tiếng
# động/backchannel, không emit thành turn.
TURN_MIN_SPEECH_MS=250
TURN_MAX_WAIT_AFTER_VAD_END_MS=300
# Speech Admission — chặn sớm frame vào ASR khi SNR quá thấp (noise phòng không đồng đều
# VAD đôi khi hiểu nhầm thành speech_start), xem docs/reference/livekit-architecture.md §5.4.
# Mặc định TẮT — cần benchmark thêm trước khi bật cho mọi call.
SPEECH_ADMISSION_ENABLED=false
SPEECH_ADMISSION_MIN_SNR_DB=6.0
SPEECH_ADMISSION_MIN_SPEECH_MS=150
# Pre-roll buffer: giữ audio chưa ADMIT để flush bù lại khi chuyển ADMIT ngay sau đó —
# tránh mất đoạn đầu câu. 600ms (thực nghiệm LiveKit thật: REJECT trước ADMIT dao động
# 240-510ms tuỳ SNR đầu câu, buffer nhỏ hơn từng bị tràn và mất chữ đầu).
SPEECH_ADMISSION_PREROLL_MS=600
# Turn Validator — lớp quyết định cuối trước khi chốt turn, dựa trên acoustic evidence +
# transcript stability. ĐỘC LẬP với Speech Admission (tracker riêng), xem docs/reference/
# livekit-architecture.md §5.4, §6. Mặc định TẮT — cần benchmark thêm trước khi bật.
TURN_VALIDATOR_ENABLED=false
TURN_VALIDATOR_MIN_SNR_DB=3.0
# Ngưỡng SNR riêng cho barge-in (InterruptionController) — KHÔNG dùng chung
# TURN_VALIDATOR_MIN_SNR_DB (validator chỉ xét SNR cho text ngắn <=2 từ, còn echo giọng
# bot qua loa/mic có thể tạo text dài, mạch lạc nên né được luật đó). Để trống (mặc định)
# tắt hẳn kiểm tra này. Ví dụ đặt 0.0 nếu gặp bug bot tự ngắt lời vì nghe lại chính nó.
INTERRUPTION_MIN_SNR_DB=

# LiveKit (streaming voice qua WebRTC — xem src/callbot/transports/livekit/)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Web giữ wideband 16 kHz; phone transport sau này vẫn có thể dùng 8 kHz.
LIVEKIT_INPUT_SAMPLE_RATE=16000
LIVEKIT_FRAME_MS=30
LIVEKIT_INPUT_QUEUE_MS=1500
LIVEKIT_BARGE_IN_PREROLL_MS=500
LIVEKIT_OUTPUT_QUEUE_MS=200
LIVEKIT_WORKER_NUM_IDLE_PROCESSES=1

# ------------------------------------------------------------
# ASR — Gemini (dùng GEMINI_API_KEY)
# ------------------------------------------------------------
GEMINI_ASR_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# ASR — PhoWhisper
# ------------------------------------------------------------
PHOWHISPER_MODEL=vinai/PhoWhisper-large

# ------------------------------------------------------------
# ASR — ZipFormer
# ------------------------------------------------------------
# Bỏ trống để local dùng asset tại src/inference/asr/providers/assets/zipformer/.
# Xem docs/reference/zipformer-model-setup.md. Docker Compose tự override các đường dẫn này.
ZIPFORMER_ENCODER_PATH=
ZIPFORMER_DECODER_PATH=
ZIPFORMER_JOINER_PATH=
ZIPFORMER_TOKENS_PATH=
# stream() (chunked-offline, đường LiveKit) không decode buffer speech ngắn hơn ngưỡng
# này — chống hallucinate ra cả cụm từ từ audio siêu ngắn như "à"/"ờm".
ZIPFORMER_MIN_DECODE_MS=400
# Flush cưỡng bức buffer khi speech liên tục vượt ngưỡng này, dù chưa có khoảng lặng đủ
# dài — chống memory leak khi VAD không bao giờ báo speech_end liên tục (đã xác nhận thực
# nghiệm: 60s audio -> 127s xử lý, 1551MB RAM). Xem docs/reference/livekit-architecture.md §5.5.
ZIPFORMER_MAX_TURN_SPEECH_MS=15000

# ------------------------------------------------------------
# ASR — ElevenLabs Realtime (dùng ELEVENLABS_API_KEY; ASR_PROVIDER=elevenlabs_realtime,
# streaming thật qua WebSocket — xem src/inference/asr/providers/elevenlabs_realtime.py)
# ------------------------------------------------------------
ELEVENLABS_REALTIME_STT_MODEL=scribe_v2_realtime
# ISO-639-3 tiếng Việt; để trống để ElevenLabs tự nhận diện ngôn ngữ.
ELEVENLABS_STT_LANGUAGE_CODE=vie
# Tối đa 50 keyterm, ngăn cách dấu phẩy. Có thể tăng chi phí STT; bỏ trống nếu không cần.
ELEVENLABS_STT_KEYTERMS=

# ------------------------------------------------------------
# TTS — OpenAI (dùng OPENAI_API_KEY)
# ------------------------------------------------------------
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ------------------------------------------------------------
# TTS — ElevenLabs (dùng ELEVENLABS_API_KEY)
# ------------------------------------------------------------
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_S=4.0
# pcm_8000 khớp băng hẹp, không phải resample; tuần 5 điện thoại có thể dùng ulaw_8000
ELEVENLABS_OUTPUT_FORMAT=pcm_8000
# Ép model đọc tiếng Việt kể cả câu ngắn dễ đoán nhầm ngôn ngữ; rỗng = để model tự đoán
ELEVENLABS_LANGUAGE_CODE=vi

# ============================================================
# Extraction qua LLM
# ============================================================
SEMANTIC_FALLBACK_ENABLED=true
SEMANTIC_FALLBACK_MODEL=gpt-4o-mini
# Timeout httpx theo pha (không phải trần tổng); một request, không retry
SEMANTIC_FALLBACK_TIMEOUT_S=3.0
SEMANTIC_FALLBACK_MAX_TOKENS=400

# ------------------------------------------------------------
# Name slot filling fallback: none | openai | gemini | groq | openrouter
# ------------------------------------------------------------
NAME_FALLBACK_PROVIDER=none
NAME_FALLBACK_MODEL=
NAME_FALLBACK_MAX_TOKENS=
NAME_FALLBACK_TIMEOUT_S=3.0

# ============================================================
# Dialogue limits
# ============================================================
MAX_FAILED_UNDERSTANDINGS=2
MAX_SILENT_TURNS=3

# ============================================================
# Redis session
# ============================================================
# Session tạm; Clinic là nơi lưu hồ sơ chính thức.
REDIS_PASSWORD=callbot
REDIS_URL=redis://:callbot@localhost:6379/0
REDIS_KEY_PREFIX=callbot
REDIS_MAXMEMORY=256mb
# Xóa nội dung sau 30 phút không hoạt động / tối đa 2 giờ.
SESSION_IDLE_TTL_S=1800
SESSION_MAX_AGE_S=7200
SESSION_TOMBSTONE_TTL_S=86400
SESSION_MAX_BYTES=262144
SESSION_LOCK_LEASE_S=60

# ============================================================
# HTTP runtime
# ============================================================
# Số process uvicorn của bot. Prod: CD ghi 2 vào .env trên server. Local: docker compose mặc định 1;
# khi CLINIC_BACKEND=sim image tự ép 1. Chạy uvicorn trực tiếp với sim thì đừng dùng --workers > 1.
# WEB_CONCURRENCY=1

# ============================================================
# Phone transport (chưa dùng bởi HTTP voice demo)
# ============================================================
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_auth_token
DEEPGRAM_SECRET_KEY=your_deepgram_secret_key
