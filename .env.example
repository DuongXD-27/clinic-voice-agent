# ============================================================
# API key model
# ============================================================
# OpenAI: TTS_PROVIDER=openai, tầng ngữ nghĩa T-05, NAME_FALLBACK_PROVIDER=openai.
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
VBEE_API_TOKEN=
VBEE_APP_ID=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ============================================================
# Clinic
# ============================================================
# Clinic mock đã deploy (§4.2); nghiệp vụ nằm dưới /v1.
CLINIC_MOCK_BASE_URL=
# Bearer key sk_...; mọi endpoint của mock trừ /health đều cần key.
CLINIC_MOCK_API_KEY=
CLINIC_ID=cl_vinmec

# ============================================================
# Bot auth
# ============================================================
# Bearer key cho /v1/calls và /demo-api, dạng sk_..., nhiều key cách nhau dấu phẩy.
# Để trống = tắt auth. /health, /ready, /audio, /demo luôn mở. Xem docs/reference/http-api.md.
BOT_API_KEYS=
# mock: gọi mock đã deploy ở trên. sim: clinic_mock_sim trong bộ nhớ, không cần mạng/key — chỉ demo
# local, dữ liệu mất khi restart; Docker tự chạy 1 worker khi sim. Để trống: uvicorn dùng mock,
# docker compose local dùng sim. Deploy (docker-compose.prod.yml) luôn là mock.
# CLINIC_BACKEND=sim
# Chỉ khi sim — bộ dữ liệu: listing3 (apt_00417 09:00, 2 slot) | mentor_mock (giống mock sau reset)
# CLINIC_SIM_DATASET=listing3
# Chỉ khi sim — edge case dựng sẵn, cách nhau dấu phẩy (xem src/clinic_mock_sim/README.md), vd slot_race
# CLINIC_SIM_SCENARIO=

# ============================================================
# Voice pipeline
# ============================================================

SAMPLE_RATE=8000
ASR_PROVIDER=zipformer
# openai | elevenlabs | vbee (xem các mục "TTS — ..." bên dưới)
TTS_PROVIDER=openai
# Provider dự phòng khi provider chính lỗi/chậm, vd TTS_PROVIDER=vbee + TTS_FALLBACK_PROVIDER=elevenlabs.
# Rỗng = không fallback. Cần đủ key của cả hai provider, thiếu thì app không khởi động.
TTS_FALLBACK_PROVIDER=
PUBLIC_BASE_URL=http://localhost:8000
AUDIO_DIR=temp/audio
VAD_RMS_THRESHOLD=500.0
VAD_END_SILENCE_MS=600

# ------------------------------------------------------------
# ASR — Gemini (dùng GEMINI_API_KEY)
# ------------------------------------------------------------
GEMINI_ASR_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# ASR — PhoWhisper
# ------------------------------------------------------------
PHOWHISPER_MODEL=vinai/PhoWhisper-large

# ------------------------------------------------------------
# ASR — ZipFormer
# ------------------------------------------------------------
# Bỏ trống để local dùng asset tại src/inference/asr/providers/assets/zipformer/.
# Xem docs/reference/zipformer-model-setup.md. Docker Compose tự override các đường dẫn này.
ZIPFORMER_ENCODER_PATH=
ZIPFORMER_DECODER_PATH=
ZIPFORMER_JOINER_PATH=
ZIPFORMER_TOKENS_PATH=

# ------------------------------------------------------------
# TTS — OpenAI (dùng OPENAI_API_KEY)
# ------------------------------------------------------------
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ------------------------------------------------------------
# TTS — Vbee Realtime HTTP (dùng VBEE_API_TOKEN, VBEE_APP_ID)
# ------------------------------------------------------------
VBEE_VOICE_CODE=hn_female_ngochuyen_full_48k-fhg
# Trần tổng một câu; giữ thấp để còn thời gian cho provider dự phòng trong 8 giây/lượt
VBEE_TIMEOUT_S=3.0
VBEE_SPEED=1.0

# ------------------------------------------------------------
# TTS — ElevenLabs (dùng ELEVENLABS_API_KEY)
# ------------------------------------------------------------
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_S=4.0
# pcm_8000 khớp băng hẹp, không phải resample; tuần 5 điện thoại có thể dùng ulaw_8000
ELEVENLABS_OUTPUT_FORMAT=pcm_8000
# Ép model đọc tiếng Việt kể cả câu ngắn dễ đoán nhầm ngôn ngữ; rỗng = để model tự đoán
ELEVENLABS_LANGUAGE_CODE=vi

# ============================================================
# Extraction qua LLM
# ============================================================
SEMANTIC_FALLBACK_ENABLED=true
SEMANTIC_FALLBACK_MODEL=gpt-4o-mini
# Timeout httpx theo pha (không phải trần tổng); một request, không retry
SEMANTIC_FALLBACK_TIMEOUT_S=3.0
SEMANTIC_FALLBACK_MAX_TOKENS=400

# ------------------------------------------------------------
# Name NER fallback: none | openai | gemini | groq | openrouter
# ------------------------------------------------------------
NAME_FALLBACK_PROVIDER=none
NAME_FALLBACK_MODEL=
NAME_FALLBACK_MAX_TOKENS=
NAME_FALLBACK_TIMEOUT_S=3.0

# ============================================================
# Dialogue limits
# ============================================================
MAX_FAILED_UNDERSTANDINGS=2
MAX_SILENT_TURNS=3

# ============================================================
# Redis session
# ============================================================
# Session tạm; Clinic là nơi lưu hồ sơ chính thức.
REDIS_PASSWORD=callbot
REDIS_URL=redis://:callbot@localhost:6379/0
REDIS_KEY_PREFIX=callbot
REDIS_MAXMEMORY=256mb
# Xóa nội dung sau 30 phút không hoạt động / tối đa 2 giờ.
SESSION_IDLE_TTL_S=1800
SESSION_MAX_AGE_S=7200
SESSION_TOMBSTONE_TTL_S=86400
SESSION_MAX_BYTES=262144
SESSION_LOCK_LEASE_S=60

# ============================================================
# HTTP runtime
# ============================================================
# Số process uvicorn của bot. Prod: CD ghi 2 vào .env trên server. Local: docker compose mặc định 1;
# khi CLINIC_BACKEND=sim image tự ép 1. Chạy uvicorn trực tiếp với sim thì đừng dùng --workers > 1.
# WEB_CONCURRENCY=1

# ============================================================
# Phone transport (chưa dùng bởi HTTP voice demo)
# ============================================================
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_auth_token
