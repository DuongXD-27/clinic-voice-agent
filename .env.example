# Clinic mock đã deploy (§4.2) — nghiệp vụ nằm dưới /v1
CLINIC_MOCK_BASE_URL=https://clinic-mock.vmec-callbot.tech/v1
# Bearer key sk_... — mọi endpoint của mock trừ /health đều cần
CLINIC_MOCK_API_KEY=

# callbot.speech
# Băng hẹp điện thoại; 16000 chỉ để so sánh WER
SAMPLE_RATE=8000
ASR_PROVIDER=gemini
TTS_PROVIDER=none
GEMINI_API_KEY=
GEMINI_ASR_MODEL=gemini-2.5-flash
PHOWHISPER_MODEL=vinai/PhoWhisper-large
PUBLIC_BASE_URL=http://localhost:8000
AUDIO_DIR=temp/audio

# callbot.engine: none (rule-based) | gemini
LLM_PROVIDER=none
GEMINI_LLM_MODEL=gemini-2.5-flash
CLINIC_ID=cl_vinmec

# Name NER via LLMGateway: none | openai | gemini | groq | openrouter
# Independent of dialogue LLM_PROVIDER; only the selected provider needs a key.
NAME_FALLBACK_PROVIDER=none
# Blank selects the provider default (OpenAI: gpt-4o-mini).
NAME_FALLBACK_MODEL=
# Blank: 200 tokens, or 1024 for Groq's reasoning model.
NAME_FALLBACK_MAX_TOKENS=
# Read/write/pool timeout per operation; connect timeout is 1 second, no retries
NAME_FALLBACK_TIMEOUT_S=3.0
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Gemini uses GEMINI_API_KEY above.

# Session store (F-03) — bắt buộc với ứng dụng HTTP; không có fallback bộ nhớ
SESSION_DATABASE_URL=postgresql://callbot:callbot@localhost:5432/callbot
SESSION_POOL_MAX_SIZE=10
# Số worker uvicorn trong Docker
WEB_CONCURRENCY=2
