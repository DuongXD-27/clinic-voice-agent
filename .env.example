# Chỉ chứa secret và giá trị riêng từng máy/deploy. Cấu hình mặc định nằm ở config/*.yaml
# (speech, asr, tts, llm, engine, session, http, livekit, tracing).
# Ghi đè bất kỳ khóa YAML nào bằng biến cùng tên viết hoa, vd. VAD_PROVIDER=webrtc,
# SEMANTIC_FALLBACK_ENABLED=false; tên biến riêng ghi cạnh khóa trong từng file YAML.
# Để trống (KEY=) nghĩa là dùng giá trị trong YAML.

# ============================================================
# API key model — chỉ cần key của provider đang bật
# ============================================================
# Vbee: tts_provider=vbee (mặc định) — cần VBEE_API_TOKEN + VBEE_APP_ID
# OpenAI: tts_provider=openai, tầng ngữ nghĩa, name_fallback_provider=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Bật Gemini STT riêng cho LiveKit; HTTP/batch tiếp tục dùng ASR_PROVIDER.
# LIVEKIT_ASR_PROVIDER=gemini_live
# GEMINI_LIVE_ASR_MODEL=gemini-3.5-transcribe-live
# GEMINI_LIVE_LANGUAGE_CODE=vi-VN
ELEVENLABS_API_KEY=
VBEE_API_TOKEN=
VBEE_APP_ID=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# OpenAI LLM mặc định dùng Fast mode (có phụ phí); đặt default để dùng Standard.
# OPENAI_SERVICE_TIER=fast

# ============================================================
# Clinic
# ============================================================
# Chỉ cần khi CLINIC_BACKEND=mock; URL nghiệp vụ phải kết thúc bằng /v1.
CLINIC_MOCK_BASE_URL=
# Bearer key sk_...; mọi endpoint của mock trừ /health đều cần key. Không cần khi CLINIC_BACKEND=sim.
CLINIC_MOCK_API_KEY=
# mock | sim — xem config/http.yaml. Docker đọc biến này để tự ép 1 worker khi sim;
# docker compose local mặc định sim, deploy luôn mock.
# CLINIC_BACKEND=sim

# ============================================================
# Bot auth
# ============================================================
# Bearer key cho /v1/calls, /v1/stt và /demo-api, dạng sk_..., nhiều key cách nhau dấu phẩy.
# Để trống = tắt auth. /health, /ready, /audio, /demo luôn mở. Xem docs/reference/http-api.md.
BOT_API_KEYS=
# Bật nút reset và danh sách dữ liệu clinic khi BOT_API_KEYS đã có giá trị.
DEMO_CLINIC_ADMIN_ENABLED=false
# Mount /v1/stt/* cho PM thử chất lượng STT trên file WAV; bắt buộc có BOT_API_KEYS.
# Xem docs/reference/stt-eval-api.md.
STT_EVAL_ENABLED=false

# ============================================================
# LiveKit (streaming voice qua WebRTC) — tham số khác ở config/livekit.yaml
# ============================================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dùng chung project LiveKit với người khác/production: đặt tên riêng (vd. viet-local) để
# cuộc gọi của bạn chỉ vào worker của bạn. FastAPI và worker đọc cùng giá trị này.
LIVEKIT_AGENT_NAME=
# Tuỳ chọn khác (tắt/mặc định giữ hành vi cũ, chỉ đổi khi cần):
# ZIPFORMER_PARTIAL_INTERVAL_RATIO=0.1   # giãn nhịp decode partial cho câu dài
# LIVEKIT_SILENCE_TIMEOUT_MS=8000        # 0 = tắt lượt im lặng

# ============================================================
# Redis session
# ============================================================
# Docker Compose yêu cầu mật khẩu Redis riêng, đặt chuỗi ngẫu nhiên dài chỉ gồm chữ và số trong .env
# (Compose chèn trực tiếp vào Redis URL; không commit .env).
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
# Namespace Redis cho session và call mode; giữ nguyên giá trị khi đổi cấu hình/deploy.
# Để trống sẽ dùng giá trị tương thích trong code.
REDIS_KEY_PREFIX=
# Chạy uvicorn ngoài Docker với Redis có mật khẩu thì đặt REDIS_URL tương ứng.
# REDIS_URL=redis://:<mật-khẩu-đã-URL-encode>@localhost:6379/0

# ============================================================
# Deploy
# ============================================================
# URL công khai để dựng audio_url (mặc định http://localhost:8000 trong config/speech.yaml)
# PUBLIC_BASE_URL=https://bot.example.com
# Số process uvicorn của bot. Prod: CD ghi 2 vào .env trên server. Local: docker compose mặc định 1;
# khi CLINIC_BACKEND=sim image tự ép 1. Chạy uvicorn trực tiếp với sim thì đừng dùng --workers > 1.
# WEB_CONCURRENCY=1

# ============================================================
# Phone transport (chưa dùng bởi HTTP voice demo)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEEPGRAM_SECRET_KEY=

# ============================================================
# Tracing — mặc định và thông số thường ở config/tracing.yaml
# ============================================================
# Bật ghi trace: sửa trace.enabled trong YAML hoặc đặt TRACE_ENABLED=true.
# Khi bật, BẮT BUỘC phải set key dưới đây và ít nhất một sink (JSONL hoặc Langfuse).
# TRACE_ENABLED=true
# HMAC-SHA256 key để pseudonymize call_id → call_key (min 32 bytes, hex hoặc base64).
# Tạo: python -c "import secrets; print(secrets.token_hex(32))"
# BẮT BUỘC khi TRACE_ENABLED=true. Nếu rỗng hoặc quá ngắn, tracer sẽ log warning TRACE_CONFIG_INVALID và tự tắt.
TRACE_PSEUDONYMIZATION_KEY=
# Thư mục local riêng từng deploy; tạo trước khi start app. Tùy chọn nếu chỉ dùng Langfuse.
TRACE_JSONL_DIR=
# TRACE_KEY_VERSION, TRACE_ENVIRONMENT: xem config/tracing.yaml.

# ============================================================
# Langfuse export — mặc định và thông số thường ở config/tracing.yaml
# ============================================================
# Bật bằng langfuse.enabled trong YAML hoặc LANGFUSE_EXPORT_ENABLED=true;
# cần TRACE_ENABLED=true. App gửi OTLP/HTTP trực tiếp.
# LANGFUSE_EXPORT_ENABLED=true
# OTLP endpoint của Langfuse (env KHÔNG cần thêm /v1/traces, code sẽ tự động normalize).
# Cloud:       https://cloud.langfuse.com/api/public/otel
# Japan:       https://jp.cloud.langfuse.com/api/public/otel
# Self-hosted: https://your-langfuse-host.com/api/public/otel
# BẮT BUỘC khi LANGFUSE_EXPORT_ENABLED=true.
LANGFUSE_OTLP_ENDPOINT=
# Langfuse project credentials (lấy từ Langfuse → Settings → API Keys).
# BẮT BUỘC khi LANGFUSE_EXPORT_ENABLED=true.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_ENVIRONMENT, LANGFUSE_TIMEOUT_SECONDS, LANGFUSE_QUEUE_SIZE,
# LANGFUSE_BATCH_SIZE, LANGFUSE_FLUSH_INTERVAL_SECONDS: xem config/tracing.yaml.

# Optional: publish only existing evaluator verdicts that carry trace_id or call_key.
# LANGFUSE_SCORE_PUBLISH_ENABLED=false
# LANGFUSE_SCORE_JSONL_DIR=  # optional: same directory as OBSERVABILITY_TRACE_DIR
# Optional approved exact-match prices; unset means UNKNOWN rather than $0.
# TRACE_LLM_PRICE_MODEL=gpt-6-luna
# TRACE_LLM_INPUT_USD_PER_MILLION=
# TRACE_LLM_OUTPUT_USD_PER_MILLION=
# TRACE_LLM_CACHED_INPUT_USD_PER_MILLION=
# TRACE_TTS_PRICE_PROVIDER=vbee
# TRACE_TTS_PRICE_VOICE=
# TRACE_TTS_USD_PER_CHARACTER=
# TRACE_STT_PRICE_MODEL=
# TRACE_STT_USD_PER_AUDIO_MINUTE=

# ============================================================
# Voice Dashboard — mặc định ở config/http.yaml
# ============================================================
# Bật read-only API tại /internal/observability/* bằng YAML hoặc env; UI ở /ui/observability.
# API không có auth: chỉ bật ở local/mạng nội bộ, không bật trên deploy công khai.
# Không cần Langfuse — đọc trực tiếp từ JSONL local.
# OBSERVABILITY_API_ENABLED=true
# Thư mục chứa trace JSONL mà dashboard API đọc.
# Nếu rỗng, code fallback sang TRACE_JSONL_DIR; nếu cả hai rỗng, API không đăng ký.
OBSERVABILITY_TRACE_DIR=
