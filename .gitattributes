# Chạy trên Linux (EC2 / Docker) — giữ LF kể cả khi checkout trên Windows với core.autocrlf=true
*.sh text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
.env.example text eol=lf
Makefile text eol=lf
# Prettier kiểm LF; không để autocrlf trên Windows làm `npm run format:check` đỏ
ui/** text=auto eol=lf
